# Puerto del servidor (en Railway se inyecta automáticamente)
PORT=3000

# URL de conexión a PostgreSQL
# En local: postgres://coopgestion:coopgestion@localhost:5432/coopgestion
# En Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://coopgestion:coopgestion@localhost:5432/coopgestion

# Clave secreta para firma de tokens JWT (usar una clave segura en producción)
JWT_SECRET=cambiar-esta-clave-en-produccion

# Orígenes permitidos por CORS (opcional si el frontend se sirve desde el mismo Express)
FRONTEND_ORIGIN=http://localhost:3000

# Días de anticipación para alerta de vencimiento de constancia de monotributo
MONOTRIBUTO_ALERT_DAYS=5

# Opcional: forzar SSL ('true' o 'false'). Si no se define, se detecta automáticamente.
# DATABASE_SSL=false
